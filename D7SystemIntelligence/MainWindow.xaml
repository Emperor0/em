<Window x:Class="D7SystemIntelligence.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D7 System Intelligence" Height="760" Width="1180" MinHeight="680" MinWidth="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14">
            <StackPanel>
                <TextBlock Text="D7" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="SYSTEM INTELLIGENCE" Foreground="{StaticResource Muted}" Margin="0,0,0,22"/>
                <Button Content="Dashboard" Click="ShowDashboard"/><Button Content="Games &amp; Launchers" Click="ShowGames"/><Button Content="Diagnostics" Click="ShowDiagnostics"/><Button Content="COD Config" Click="ShowCod"/><Button Content="Fans" Click="ShowFans"/><Button Content="Updates &amp; Repair" Click="ShowUpdates"/>
                <Separator Margin="6,18"/>
                <TextBlock Text="AUTOPILOT" Foreground="{StaticResource Muted}"/>
                <ComboBox x:Name="AutopilotBox" Margin="4,8" SelectedIndex="1"><ComboBoxItem Content="SAFE"/><ComboBoxItem Content="BALANCED"/><ComboBoxItem Content="MAX PERFORMANCE"/></ComboBox>
                <TextBlock x:Name="StatusText" Text="Engine starting…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,18,4,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid x:Name="DashboardPage">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Machine Overview" FontSize="28" FontWeight="SemiBold"/>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,18">
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="4" Padding="16"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuText" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="CpuSub" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="4" Padding="16"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="GpuText" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="GpuSub" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="4" Padding="16"><StackPanel><TextBlock Text="RAM" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RamText" FontSize="22" FontWeight="Bold"/><TextBlock Text="Live pressure" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="4" Padding="16"><StackPanel><TextBlock Text="VRAM" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VramText" FontSize="22" FontWeight="Bold"/><TextBlock Text="GPU memory load" Foreground="{StaticResource Muted}"/></StackPanel></Border>
                </UniformGrid>
                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="What D7 is doing" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Hardware telemetry • launcher discovery • safe config adapters • diagnostics • fan controls where hardware exposes writable PWM • application updates • rollback-first changes" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Run full quick scan" HorizontalAlignment="Left" Click="RunAllScan"/></StackPanel></Border>
            </Grid>
            <Grid x:Name="GamesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Games &amp; Launchers" FontSize="28" FontWeight="SemiBold"/><Button Content="RESCAN" Click="RescanGames" Margin="20,0,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="GamesGrid" Margin="0,18,0,0" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="Black"><DataGrid.Columns><DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Launcher" Binding="{Binding Launcher}" Width="*"/><DataGridTextColumn Header="Install path" Binding="{Binding InstallPath}" Width="3*"/><DataGridTextColumn Header="Executable" Binding="{Binding ExecutablePath}" Width="3*"/></DataGrid.Columns></DataGrid></Grid>
            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Diagnostics" FontSize="28" FontWeight="SemiBold"/><Button Grid.Row="1" Content="RUN DIAGNOSTIC" HorizontalAlignment="Left" Margin="0,16" Click="RunDiagnostic"/><ListBox Grid.Row="2" x:Name="DiagnosticsList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/></Grid>
            <Grid x:Name="CodPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Call of Duty Config Intelligence" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Schema-aware adapter. D7 only edits known COD keys, makes a timestamped backup, writes a temporary file, verifies the result, then replaces the original." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12"/><TextBox x:Name="CodInfo" Height="270" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><StackPanel Orientation="Horizontal" Margin="0,12"><Button Content="SCAN COD CONFIG" Click="ScanCod"/><Button Content="APPLY BALANCED" Click="ApplyCodBalanced"/><Button Content="APPLY QUALITY" Click="ApplyCodQuality"/></StackPanel></StackPanel></Grid>
            <Grid x:Name="FansPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Thermal &amp; Fan Control" FontSize="28" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Only fans exposed as writable controls by LibreHardwareMonitor can be changed. D7 never forces unsupported headers and restores firmware/default control when it exits." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12"/><DataGrid Grid.Row="2" x:Name="FansGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource Panel}" Foreground="Black"><DataGrid.Columns><DataGridTextColumn Header="Fan" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="RPM" Binding="{Binding Rpm}" Width="*"/><DataGridCheckBoxColumn Header="Controllable" Binding="{Binding Controllable}" Width="*"/><DataGridTextColumn Header="Control %" Binding="{Binding ControlPercent}" Width="*"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" VerticalAlignment="Bottom" Orientation="Horizontal" Background="#CC0B0E14"><Button Content="Set controllable fans 45%" Click="Fans45"/><Button Content="Set controllable fans 70%" Click="Fans70"/><Button Content="RESTORE BIOS/AUTO" Click="FansRestore"/></StackPanel></Grid>
            <Grid x:Name="UpdatesPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Updates &amp; Repair" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="D7 uses Windows Package Manager for app inventory/updates. Updates are never installed automatically without your action." Foreground="{StaticResource Muted}" Margin="0,12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button Content="CHECK APP UPDATES" Click="CheckUpdates"/><Button Content="UPDATE ALL APPS" Click="UpdateApps"/><Button Content="WINDOWS HEALTH SCAN" Click="WindowsRepairScan"/></StackPanel><TextBox x:Name="UpdatesOutput" Height="470" Margin="0,12,0,0" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
