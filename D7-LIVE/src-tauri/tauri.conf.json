{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "D7 LIVE",
  "version": "1.0.0",
  "identifier": "com.d7kt.d7live",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "D7 LIVE",
        "width": 1480,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": { "wix": { "language": "en-US" } }
  }
}
